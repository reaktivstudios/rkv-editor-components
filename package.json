{
	"name": "@reaktiv/editor-components",
	"version": "0.1.1",
	"description": "Reusable block editor components from Reaktiv Studios.",
	"author": "Reaktiv",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"block-editor",
		"components"
	],
	"type": "module",
	"main": "build/index.js",
	"module": "build/index.js",
	"exports": {
		".": "./build/index.js",
		"./editor.css": "./build/editor.css",
		"./style.css": "./build/editor.css"
	},
	"files": [
		"build",
		"src",
		"!src/**/*.test.js"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "npm run build:js && npm run build:css",
		"build:js": "babel src --out-dir build --delete-dir-on-start --ignore \"src/**/*.test.js\"",
		"build:css": "sass --no-source-map src:build",
		"prepublishOnly": "npm run build",
		"test": "jest"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@wordpress/block-editor": ">=14",
		"@wordpress/components": ">=28",
		"@wordpress/compose": ">=7",
		"@wordpress/core-data": ">=7",
		"@wordpress/data": ">=10",
		"@wordpress/date": ">=5",
		"@wordpress/element": ">=6",
		"@wordpress/html-entities": ">=4",
		"@wordpress/i18n": ">=5",
		"@wordpress/keycodes": ">=4",
		"react": ">=18"
	},
	"dependencies": {
		"classnames": "^2.5.1",
		"@wordpress/icons": "^17.0.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.7",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@wordpress/babel-preset-default": "^8.56.0",
		"@wordpress/date": "^5.56.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/html-entities": "^4.56.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/keycodes": "^4.56.0",
		"babel-jest": "^30.5.2",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.105.0"
	},
	"peerDependenciesMeta": {
		"@wordpress/block-editor": {
			"optional": true
		},
		"@wordpress/components": {
			"optional": true
		},
		"@wordpress/compose": {
			"optional": true
		},
		"@wordpress/core-data": {
			"optional": true
		},
		"@wordpress/data": {
			"optional": true
		},
		"@wordpress/date": {
			"optional": true
		},
		"@wordpress/element": {
			"optional": true
		},
		"@wordpress/html-entities": {
			"optional": true
		},
		"@wordpress/i18n": {
			"optional": true
		},
		"@wordpress/keycodes": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
