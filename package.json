{
	"name": "@reaktiv/editor-components",
	"version": "0.2.0",
	"description": "Reusable block editor components from Reaktiv Studios.",
	"author": "Reaktiv",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reaktivstudios/rkv-editor-components.git"
	},
	"homepage": "https://github.com/reaktivstudios/rkv-editor-components#readme",
	"bugs": {
		"url": "https://github.com/reaktivstudios/rkv-editor-components/issues"
	},
	"keywords": [
		"wordpress",
		"gutenberg",
		"block-editor",
		"components"
	],
	"type": "module",
	"main": "build/index.js",
	"module": "build/index.js",
	"exports": {
		".": "./build/index.js",
		"./editor.css": "./build/editor.css",
		"./style.css": "./build/editor.css"
	},
	"files": [
		"build",
		"src",
		"!src/**/*.test.js",
		"!src/**/*.stories.js"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "npm run build:js && npm run build:css",
		"build:js": "babel src --out-dir build --delete-dir-on-start --ignore \"src/**/*.test.js\",\"src/**/*.stories.js\"",
		"build:css": "sass --no-source-map src:build",
		"prepublishOnly": "npm run build",
		"test": "jest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@wordpress/block-editor": ">=14",
		"@wordpress/components": ">=28",
		"@wordpress/compose": ">=7",
		"@wordpress/core-data": ">=7",
		"@wordpress/data": ">=10",
		"@wordpress/date": ">=5",
		"@wordpress/element": ">=6",
		"@wordpress/html-entities": ">=4",
		"@wordpress/i18n": ">=5",
		"@wordpress/keycodes": ">=4",
		"react": ">=18"
	},
	"dependencies": {
		"@wordpress/icons": "^17.0.0",
		"classnames": "^2.5.1"
	},
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.7",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/babel-preset-default": "^8.56.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/compose": "^8.9.0",
		"@wordpress/core-data": "^8.1.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/date": "^5.56.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/html-entities": "^4.56.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/keycodes": "^4.56.0",
		"babel-jest": "^30.5.2",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.105.0",
		"storybook": "^10.6.0",
		"vite": "^8.3.1"
	},
	"peerDependenciesMeta": {
		"@wordpress/block-editor": {
			"optional": true
		},
		"@wordpress/components": {
			"optional": true
		},
		"@wordpress/compose": {
			"optional": true
		},
		"@wordpress/core-data": {
			"optional": true
		},
		"@wordpress/data": {
			"optional": true
		},
		"@wordpress/date": {
			"optional": true
		},
		"@wordpress/element": {
			"optional": true
		},
		"@wordpress/html-entities": {
			"optional": true
		},
		"@wordpress/i18n": {
			"optional": true
		},
		"@wordpress/keycodes": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
